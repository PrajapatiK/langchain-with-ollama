*.so
.Python
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================
# Virtual Environment
# ==========================

.venv/
venv/
env/
ENV/

# ==========================
# Environment Variables
# ==========================

.env
.env.*
!.env.example

# ==========================
# SQLite Database
# ==========================

*.db
*.sqlite
*.sqlite3

# ==========================
# Streamlit
# ==========================

.streamlit/secrets.toml

# ==========================
# IDE
# ==========================

.vscode/
.idea/
*.iml

# ==========================
